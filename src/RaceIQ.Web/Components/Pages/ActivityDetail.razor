@page "/activities/{ActivityId:int}"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using RaceIQ.Application
@using RaceIQ.Domain
@inject IActivityRepository ActivityRepository
@inject IAnalysisReportRepository AnalysisReportRepository
@inject IRaceResultRepository RaceResultRepository
@inject IActivityAnalysisService ActivityAnalysisService
@inject ILogger<ActivityDetail> Logger

<a href="/dashboard" class="back-link">&larr; Dine ture</a>

@if (_activity is null)
{
    <div class="card empty-state">
        <p>Turen blev ikke fundet.</p>
    </div>
}
else
{
    <h1>@_activity.Name</h1>

    <dl class="stat-strip">
        <div>
            <dt>Dato</dt>
            <dd>@_activity.StartedAt.ToShortDateString()</dd>
        </div>
        <div>
            <dt>Distance</dt>
            <dd>@((_activity.DistanceMeters / 1000).ToString("F1")) km</dd>
        </div>
        <div>
            <dt>Varighed</dt>
            <dd>@_activity.Duration.TotalMinutes.ToString("F0") min</dd>
        </div>
        <div>
            <dt>Snit effekt</dt>
            <dd>@(_activity.AveragePowerWatts?.ToString("F0") ?? "-") W</dd>
        </div>
    </dl>

    @if (_raceResults.Count > 0)
    {
        <div class="card race-result-card">
            <h3>Løbsresultat</h3>
            @foreach (var result in _raceResults)
            {
                <p>
                    @result.Provider · @result.EventName
                    @if (result.Category is { } cat) { <text> · Kategori @cat</text> }
                    @if (result.Position is { } pos)
                    {
                        <text> · Nummer @pos@(result.FieldSize is { } size ? $" af {size}" : "")</text>
                    }
                    @if (result.RatingChange is { } change)
                    {
                        <text> · vELO @(change >= 0 ? "+" : "")@change.ToString("F1")</text>
                    }
                </p>
            }
        </div>
    }

    @if (_report is null)
    {
        <button class="btn btn-primary" @onclick="AnalyzeAsync" disabled="@_analyzing">
            @(_analyzing ? "Analyserer..." : "Analysér")
        </button>
    }
    else
    {
        <h2>AI-pacinganalyse</h2>
        <div class="card analysis-card">@_report.ReportText</div>
    }

    @if (_analysisError is not null)
    {
        <div class="alert alert-danger">@_analysisError</div>
    }
}

@code {
    [Parameter]
    public int ActivityId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private Activity? _activity;
    private AnalysisReport? _report;
    private IReadOnlyList<RaceResult> _raceResults = Array.Empty<RaceResult>();
    private bool _analyzing;
    private string? _analysisError;
    private string _userId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState!;
        _userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier)!;

        _activity = await ActivityRepository.GetByIdAsync(ActivityId, _userId);
        if (_activity is not null)
        {
            _report = await AnalysisReportRepository.GetForActivityAsync(_activity.Id);
            _raceResults = await RaceResultRepository.GetForActivityAsync(_activity.Id);
        }
    }

    private async Task AnalyzeAsync()
    {
        _analyzing = true;
        _analysisError = null;

        try
        {
            _report = await ActivityAnalysisService.AnalyzeAsync(ActivityId, _userId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Activity analysis failed for activity {ActivityId} and user {UserId}", ActivityId, _userId);
            _analysisError = "Analysen fejlede. Prøv igen om lidt.";
        }
        finally
        {
            _analyzing = false;
        }
    }
}
