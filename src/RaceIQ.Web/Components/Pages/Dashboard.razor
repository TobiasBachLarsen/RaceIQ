@page "/"
@page "/dashboard"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using RaceIQ.Application
@using RaceIQ.Domain
@using RaceIQ.Infrastructure.Strava
@using RaceIQ.Infrastructure.ZwiftPower
@using RaceIQ.Infrastructure.ZwiftRacing
@inject IConnectedAccountRepository ConnectedAccountRepository
@inject IActivityRepository ActivityRepository
@inject IRaceResultRepository RaceResultRepository
@inject IStravaSyncService StravaSyncService
@inject IZwiftPowerSyncService ZwiftPowerSyncService
@inject IZwiftRacingSyncService ZwiftRacingSyncService
@inject ILogger<Dashboard> Logger

<div class="dashboard-header">
    <h1>Dine ture</h1>

    @if (_connectedAccount is { Status: ConnectedAccountStatus.Connected })
    {
        <button class="btn btn-primary" @onclick="SyncAsync" disabled="@_syncing">
            @(_syncing ? "Synkroniserer..." : "Synkronisér")
        </button>
    }
</div>

@if (_connectedAccount is null)
{
    <div class="card empty-state">
        <p>Forbind din Strava-konto for at hente dine ture.</p>
        <a href="/strava/connect" class="btn btn-primary">Forbind Strava</a>
    </div>
}
else if (_connectedAccount.Status == ConnectedAccountStatus.NeedsReconnect)
{
    <div class="card empty-state">
        <span class="status-badge status-badge--warning">Skal genoprettes</span>
        <p>Din Strava-forbindelse skal opdateres, før du kan synkronisere igen.</p>
        <a href="/strava/connect" class="btn btn-primary">Genopret forbindelse</a>
    </div>
}

@if (_zwiftPowerAccount is null || _zwiftPowerAccount.Status == ConnectedAccountStatus.NeedsReconnect)
{
    <div class="card empty-state">
        @if (_zwiftPowerAccount is { Status: ConnectedAccountStatus.NeedsReconnect })
        {
            <span class="status-badge status-badge--warning">ZwiftPower skal genoprettes</span>
            <p>Cookien er sandsynligvis udløbet. Gentag forbindelsen nedenfor med en frisk cookie.</p>
        }
        else
        {
            <p>
                Forbind ZwiftPower for at få dine løbsresultater vist. Log ind på
                <a href="https://zwiftpower.com" target="_blank" rel="noopener">zwiftpower.com</a>,
                åbn browserens udviklerværktøjer (Application/Storage → Cookies), kopiér din
                session-cookie, og find dit Zwift-rytter-id på din profilside (tallet i URL'en).
            </p>
        }
        <form method="post" action="/zwiftpower/connect">
            <AntiforgeryToken />
            <input class="form-control mb-3" name="sessionCookie" placeholder="Session-cookie" required />
            <input class="form-control mb-3" name="zwiftRiderId" placeholder="Zwift-rytter-id" required />
            <button type="submit" class="btn btn-primary">Forbind ZwiftPower</button>
        </form>
    </div>
}

@if (_zwiftRacingAccount is null || _zwiftRacingAccount.Status == ConnectedAccountStatus.NeedsReconnect)
{
    <div class="card empty-state">
        @if (_zwiftRacingAccount is { Status: ConnectedAccountStatus.NeedsReconnect })
        {
            <span class="status-badge status-badge--warning">ZwiftRacing skal genoprettes</span>
            <p>Nøglen virker ikke længere. Forbind igen nedenfor.</p>
        }
        else
        {
            <p>
                Forbind ZwiftRacing for vELO-data. Bed om en API-nøgle via deres Discord-server,
                og find dit Zwift-rytter-id på din profil.
            </p>
        }
        <form method="post" action="/zwiftracing/connect">
            <AntiforgeryToken />
            <input class="form-control mb-3" name="apiKey" placeholder="API-nøgle" required />
            <input class="form-control mb-3" name="zwiftRiderId" placeholder="Zwift-rytter-id" required />
            <button type="submit" class="btn btn-primary">Forbind ZwiftRacing</button>
        </form>
    </div>
}

@if (_syncError is not null)
{
    <div class="alert alert-danger">@_syncError</div>
}

@if (_activities is { Count: > 0 })
{
    <div class="table-wrap">
        <table class="rides-table">
            <thead>
                <tr><th>Tur</th><th>Dato</th><th>Distance</th><th>Snit effekt</th><th>Løb</th></tr>
            </thead>
            <tbody>
                @foreach (var activity in _activities)
                {
                    <tr>
                        <td><a href="/activities/@activity.Id">@activity.Name</a></td>
                        <td>@activity.StartedAt.ToShortDateString()</td>
                        <td class="num">@((activity.DistanceMeters / 1000).ToString("F1")) km</td>
                        <td class="num">@(activity.AveragePowerWatts?.ToString("F0") ?? "-") W</td>
                        <td class="num">
                            @if (_raceResultsByActivityId.TryGetValue(activity.Id, out var raceResults))
                            {
                                var position = raceResults.Select(r => r.Position).FirstOrDefault(p => p is not null);
                                var category = raceResults.Select(r => r.Category).FirstOrDefault(c => c is not null);
                                @($"P{position?.ToString() ?? "-"}" + (category is { } cat ? $" · Cat {cat}" : ""))
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (_connectedAccount is { Status: ConnectedAccountStatus.Connected })
{
    <div class="card empty-state">
        <p>Ingen ture endnu. Synkronisér for at hente dine seneste ture fra Strava.</p>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private ConnectedAccount? _connectedAccount;
    private ConnectedAccount? _zwiftPowerAccount;
    private ConnectedAccount? _zwiftRacingAccount;
    private IReadOnlyList<Activity>? _activities;
    private Dictionary<int, IReadOnlyList<RaceResult>> _raceResultsByActivityId = new();
    private bool _syncing;
    private string? _syncError;
    private string _userId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _userId = await GetUserIdAsync();
        _connectedAccount = await ConnectedAccountRepository.GetAsync(_userId, ConnectedAccountProvider.Strava);
        _zwiftPowerAccount = await ConnectedAccountRepository.GetAsync(_userId, ConnectedAccountProvider.ZwiftPower);
        _zwiftRacingAccount = await ConnectedAccountRepository.GetAsync(_userId, ConnectedAccountProvider.ZwiftRacing);
        _activities = await ActivityRepository.GetAllForUserAsync(_userId);
        await LoadRaceResultsAsync();
    }

    private async Task<string> GetUserIdAsync()
    {
        var state = await AuthState!;
        return state.User.FindFirstValue(ClaimTypes.NameIdentifier)!;
    }

    private async Task LoadRaceResultsAsync()
    {
        _raceResultsByActivityId = new Dictionary<int, IReadOnlyList<RaceResult>>();
        foreach (var activity in _activities ?? Array.Empty<Activity>())
        {
            var results = await RaceResultRepository.GetForActivityAsync(activity.Id);
            if (results.Count > 0)
                _raceResultsByActivityId[activity.Id] = results;
        }
    }

    private async Task SyncAsync()
    {
        _syncing = true;
        _syncError = null;

        try
        {
            try
            {
                await StravaSyncService.SyncAsync(_userId);
                _activities = await ActivityRepository.GetAllForUserAsync(_userId);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Strava sync failed for user {UserId}", _userId);
                _syncError = "Synkronisering fejlede. Prøv igen om lidt.";
            }

            if (_zwiftPowerAccount is not null)
            {
                try
                {
                    await ZwiftPowerSyncService.SyncAsync(_userId);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "ZwiftPower sync failed for user {UserId}", _userId);
                }
            }

            if (_zwiftRacingAccount is not null)
            {
                try
                {
                    await ZwiftRacingSyncService.SyncAsync(_userId);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "ZwiftRacing sync failed for user {UserId}", _userId);
                }
            }

            try
            {
                await LoadRaceResultsAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to reload race results for user {UserId}", _userId);
            }

            try
            {
                _connectedAccount = await ConnectedAccountRepository.GetAsync(_userId, ConnectedAccountProvider.Strava);
                _zwiftPowerAccount = await ConnectedAccountRepository.GetAsync(_userId, ConnectedAccountProvider.ZwiftPower);
                _zwiftRacingAccount = await ConnectedAccountRepository.GetAsync(_userId, ConnectedAccountProvider.ZwiftRacing);
            }
            catch
            {
                // best-effort status refresh — keep the last known values rather than crashing the circuit
            }
        }
        finally
        {
            // guarantees the sync button can never get stuck disabled, even if something
            // above throws in a way none of the inner catches anticipated
            _syncing = false;
        }
    }
}
