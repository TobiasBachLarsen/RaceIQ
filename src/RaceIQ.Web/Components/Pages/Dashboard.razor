@page "/"
@page "/dashboard"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using RaceIQ.Application
@using RaceIQ.Domain
@inject IConnectedAccountRepository ConnectedAccountRepository
@inject IActivityRepository ActivityRepository
@inject IRaceResultRepository RaceResultRepository
@inject IRecoveryDayRepository RecoveryDayRepository
@inject SyncCoordinator SyncCoordinator
@inject ILogger<Dashboard> Logger
@inject NavigationManager Navigation

<div class="dashboard-header">
    <h1>Dine ture</h1>

    @if (AnyProviderConnected)
    {
        <button class="btn btn-primary" @onclick="SyncAsync" disabled="@_syncing">
            @(_syncing ? "Synkroniserer..." : "Synkronisér")
        </button>
    }
</div>

@if (_activities is { Count: > 0 } && _stats is not null)
{
    <OverviewPanel Stats="_stats" LatestRecovery="_latestRecovery" />
}

@if (_connectedAccount is null)
{
    <div class="card empty-state">
        <p>Forbind din Strava-konto for at hente dine ture.</p>
        <a href="/strava/connect" class="btn btn-primary">Forbind Strava</a>
    </div>
}
else if (_connectedAccount.Status == ConnectedAccountStatus.NeedsReconnect)
{
    <div class="card empty-state">
        <span class="status-badge status-badge--warning">Skal genoprettes</span>
        <p>Din Strava-forbindelse skal opdateres, før du kan synkronisere igen.</p>
        <a href="/strava/connect" class="btn btn-primary">Genopret forbindelse</a>
    </div>
}

<ZwiftPowerImportCard InitialRiderId="@_zwiftPowerAccount?.ExternalAccountId" />

@if (_zwiftPowerMessage is not null)
{
    <div class="alert @(_zwiftPowerImportFailed ? "alert-danger" : "alert-success")">@_zwiftPowerMessage</div>
}

<ProviderConnectionCard
    Account="_zwiftRacingAccount"
    ActionUrl="/zwiftracing/connect"
    PrimaryFieldName="apiKey"
    PrimaryFieldPlaceholder="API-nøgle"
    ConnectButtonText="Forbind ZwiftRacing"
    ReconnectBadgeText="ZwiftRacing skal genoprettes"
    ReconnectMessage="Nøglen virker ikke længere. Forbind igen nedenfor.">
    <Instructions>
        <p>
            Forbind ZwiftRacing for vELO-data. Bed om en API-nøgle via deres Discord-server,
            og find dit Zwift-rytter-id på din profil.
        </p>
    </Instructions>
</ProviderConnectionCard>

@if (_whoopAccount is null)
{
    <div class="card empty-state">
        <p>Forbind WHOOP for at se din daglige restitution (recovery, HRV og hvilepuls) sammen med dine ture.</p>
        <a href="/whoop/connect" class="btn btn-primary">Forbind WHOOP</a>
    </div>
}
else if (_whoopAccount.Status == ConnectedAccountStatus.NeedsReconnect)
{
    <div class="card empty-state">
        <span class="status-badge status-badge--warning">WHOOP skal genoprettes</span>
        <p>Din WHOOP-forbindelse skal opdateres, før restitution kan synkroniseres igen.</p>
        <a href="/whoop/connect" class="btn btn-primary">Genopret forbindelse</a>
    </div>
}

@if (_syncError is not null)
{
    <div class="alert alert-danger">@_syncError</div>
}

@if (_activities is { Count: > 0 })
{
    <RideTable Activities="_activities" RaceResultsByActivityId="_raceResultsByActivityId" />
}
else if (_connectedAccount is { Status: ConnectedAccountStatus.Connected })
{
    <div class="card empty-state">
        <p>Ingen ture endnu. Synkronisér for at hente dine seneste ture fra Strava.</p>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private ConnectedAccount? _connectedAccount;
    private ConnectedAccount? _zwiftPowerAccount;
    private ConnectedAccount? _zwiftRacingAccount;
    private ConnectedAccount? _whoopAccount;
    private RecoveryDay? _latestRecovery;
    private IReadOnlyList<Activity>? _activities;
    private IReadOnlyDictionary<int, IReadOnlyList<RaceResult>> _raceResultsByActivityId =
        new Dictionary<int, IReadOnlyList<RaceResult>>();
    private OverviewStats? _stats;
    private bool _syncing;
    private string? _syncError;
    private string? _zwiftPowerMessage;
    private bool _zwiftPowerImportFailed;
    private string _userId = string.Empty;

    // ZwiftPower is a manual paste-import, not a synced provider, so it doesn't count here.
    private bool AnyProviderConnected =>
        _connectedAccount is { Status: ConnectedAccountStatus.Connected } ||
        _zwiftRacingAccount is { Status: ConnectedAccountStatus.Connected } ||
        _whoopAccount is { Status: ConnectedAccountStatus.Connected };

    protected override async Task OnInitializedAsync()
    {
        _userId = await GetUserIdAsync();
        ReadZwiftPowerImportOutcome();
        await LoadStateAsync();
    }

    // The ZwiftPower import is a plain form post that redirects back here with its
    // outcome in the query string ("12-9" = imported-matched, or "error").
    private void ReadZwiftPowerImportOutcome()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (!query.TryGetValue("zwiftpower", out var value))
            return;

        var outcome = value.ToString();
        if (outcome == "error")
        {
            _zwiftPowerImportFailed = true;
            _zwiftPowerMessage = "Teksten kunne ikke læses som ZwiftPower-resultater. Åbn linket, marker alt, kopiér og indsæt igen.";
            return;
        }

        var parts = outcome.Split('-');
        if (parts.Length == 2 && int.TryParse(parts[0], out var imported) && int.TryParse(parts[1], out var matched))
            _zwiftPowerMessage = $"Importerede {imported} løb fra ZwiftPower, {matched} matchet til dine ture.";
    }

    private async Task<string> GetUserIdAsync()
    {
        var state = await AuthState!;
        return state.User.FindFirstValue(ClaimTypes.NameIdentifier)!;
    }

    // The full dashboard state: the four provider accounts plus activities, their
    // race results, and the latest recovery. Used as-is on first load; SyncAsync below reloads the same two
    // halves (accounts, activities+race-results) separately instead, since it needs
    // different error handling for each.
    private async Task LoadStateAsync()
    {
        await LoadAccountsAsync();
        await LoadActivitiesAndRaceResultsAsync();
    }

    private async Task LoadAccountsAsync()
    {
        _connectedAccount = await ConnectedAccountRepository.GetAsync(_userId, ConnectedAccountProvider.Strava);
        _zwiftPowerAccount = await ConnectedAccountRepository.GetAsync(_userId, ConnectedAccountProvider.ZwiftPower);
        _zwiftRacingAccount = await ConnectedAccountRepository.GetAsync(_userId, ConnectedAccountProvider.ZwiftRacing);
        _whoopAccount = await ConnectedAccountRepository.GetAsync(_userId, ConnectedAccountProvider.Whoop);
    }

    private async Task LoadActivitiesAndRaceResultsAsync()
    {
        _activities = await ActivityRepository.GetAllForUserAsync(_userId);
        await LoadRaceResultsAsync();

        var allRaceResults = await RaceResultRepository.GetAllForUserAsync(_userId);
        _stats = OverviewStatsBuilder.Build(_activities, allRaceResults, DateTime.UtcNow);
        _latestRecovery = await RecoveryDayRepository.GetLatestAsync(_userId);
    }

    private async Task LoadRaceResultsAsync()
    {
        var activityIds = (_activities ?? Array.Empty<Activity>()).Select(a => a.Id).ToList();
        _raceResultsByActivityId = await RaceResultRepository.GetForActivitiesAsync(_userId, activityIds);
    }

    private async Task SyncAsync()
    {
        _syncing = true;
        _syncError = null;

        try
        {
            var outcome = await SyncCoordinator.SyncAllAsync(_userId);
            if (outcome.StravaFailed)
                _syncError = "Synkronisering fejlede. Prøv igen om lidt.";

            try
            {
                await LoadActivitiesAndRaceResultsAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to reload activities and race results for user {UserId}", _userId);
            }

            try
            {
                await LoadAccountsAsync();
            }
            catch
            {
                // best-effort status refresh — keep the last known values rather than crashing the circuit
            }
        }
        finally
        {
            // guarantees the sync button can never get stuck disabled, even if something
            // above throws in a way none of the inner catches anticipated
            _syncing = false;
        }
    }
}
