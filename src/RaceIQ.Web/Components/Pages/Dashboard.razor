@page "/"
@page "/dashboard"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using RaceIQ.Application
@using RaceIQ.Domain
@using RaceIQ.Infrastructure.Strava
@inject IConnectedAccountRepository ConnectedAccountRepository
@inject IActivityRepository ActivityRepository
@inject IStravaSyncService StravaSyncService
@inject ILogger<Dashboard> Logger

<div class="dashboard-header">
    <h1>Dine ture</h1>

    @if (_connectedAccount is { Status: ConnectedAccountStatus.Connected })
    {
        <button class="btn btn-primary" @onclick="SyncAsync" disabled="@_syncing">
            @(_syncing ? "Synkroniserer..." : "Synkronisér")
        </button>
    }
</div>

@if (_connectedAccount is null)
{
    <div class="card empty-state">
        <p>Forbind din Strava-konto for at hente dine ture.</p>
        <a href="/strava/connect" class="btn btn-primary">Forbind Strava</a>
    </div>
}
else if (_connectedAccount.Status == ConnectedAccountStatus.NeedsReconnect)
{
    <div class="card empty-state">
        <span class="status-badge status-badge--warning">Skal genoprettes</span>
        <p>Din Strava-forbindelse skal opdateres, før du kan synkronisere igen.</p>
        <a href="/strava/connect" class="btn btn-primary">Genopret forbindelse</a>
    </div>
}

@if (_syncError is not null)
{
    <div class="alert alert-danger">@_syncError</div>
}

@if (_activities is { Count: > 0 })
{
    <div class="table-wrap">
        <table class="rides-table">
            <thead>
                <tr><th>Tur</th><th>Dato</th><th>Distance</th><th>Snit effekt</th></tr>
            </thead>
            <tbody>
                @foreach (var activity in _activities)
                {
                    <tr>
                        <td><a href="/activities/@activity.Id">@activity.Name</a></td>
                        <td>@activity.StartedAt.ToShortDateString()</td>
                        <td class="num">@((activity.DistanceMeters / 1000).ToString("F1")) km</td>
                        <td class="num">@(activity.AveragePowerWatts?.ToString("F0") ?? "-") W</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (_connectedAccount is { Status: ConnectedAccountStatus.Connected })
{
    <div class="card empty-state">
        <p>Ingen ture endnu. Synkronisér for at hente dine seneste ture fra Strava.</p>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private ConnectedAccount? _connectedAccount;
    private IReadOnlyList<Activity>? _activities;
    private bool _syncing;
    private string? _syncError;
    private string _userId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _userId = await GetUserIdAsync();
        _connectedAccount = await ConnectedAccountRepository.GetAsync(_userId, ConnectedAccountProvider.Strava);
        _activities = await ActivityRepository.GetAllForUserAsync(_userId);
    }

    private async Task<string> GetUserIdAsync()
    {
        var state = await AuthState!;
        return state.User.FindFirstValue(ClaimTypes.NameIdentifier)!;
    }

    private async Task SyncAsync()
    {
        _syncing = true;
        _syncError = null;

        try
        {
            await StravaSyncService.SyncAsync(_userId);
            _activities = await ActivityRepository.GetAllForUserAsync(_userId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Strava sync failed for user {UserId}", _userId);
            _syncError = "Synkronisering fejlede. Prøv igen om lidt.";
        }
        finally
        {
            _syncing = false;

            try
            {
                _connectedAccount = await ConnectedAccountRepository.GetAsync(_userId, ConnectedAccountProvider.Strava);
            }
            catch
            {
                // best-effort status refresh — keep the last known value rather than crashing the circuit
            }
        }
    }
}
