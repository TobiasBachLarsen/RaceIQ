@using RaceIQ.Application
@using RaceIQ.Domain

<div class="overview card">
    <section class="overview-section">
        <p class="overview-caption">I alt</p>
        <div class="stat-grid">
            <StatTile Value="@Stats.RideCount.ToString()" Label="Ture" />
            <StatTile Value="@Stats.TotalDistanceKm.ToString("N0")" Unit="km" Label="Distance" />
            <StatTile Value="@Hours(Stats.TotalDuration)" Unit="t" Label="Tid på cyklen" />
            <StatTile Value="@Stats.TotalElevationM.ToString("N0")" Unit="m" Label="Højdemeter" />
            <StatTile Value="@Stats.RaceCount.ToString()" Label="Løb" />
            <StatTile Value="@(Stats.BestPosition is { } p ? $"{p}." : "–")" Label="Bedste placering" />
            <StatTile Value="@Rating(Stats.TotalRatingChange)" CssClass="@RatingClass(Stats.TotalRatingChange)" Label="Rating i alt" />
        </div>
    </section>

    <section class="overview-section">
        <p class="overview-caption">Seneste 30 dage</p>
        <div class="stat-grid">
            <StatTile Value="@Stats.RecentRideCount.ToString()" CssClass="stat-num--small" Label="Ture" />
            <StatTile Value="@Stats.RecentDistanceKm.ToString("N0")" Unit="km" CssClass="stat-num--small" Label="Distance" />
            <StatTile Value="@Hours(Stats.RecentDuration)" Unit="t" CssClass="stat-num--small" Label="Tid" />
            <StatTile Value="@(Stats.RecentAvgPower is { } w ? w.ToString("N0") : "–")"
                      Unit="@(Stats.RecentAvgPower is not null ? "W" : null)"
                      CssClass="stat-num--small" Label="Snit effekt" />
        </div>
    </section>

    @if (LatestRecovery is { } recovery)
    {
        <section class="overview-section">
            <p class="overview-caption">Restitution · WHOOP · @recovery.Date.ToString("d. MMM")</p>
            <div class="stat-grid">
                <StatTile Value="@recovery.RecoveryScore.ToString()" Unit="%" CssClass="@($"stat-num--small {BandClass(recovery.Band)}")" Label="Recovery" />
                <StatTile Value="@recovery.HrvMs.ToString("N0")" Unit="ms" CssClass="stat-num--small" Label="HRV" />
                <StatTile Value="@recovery.RestingHeartRate.ToString()" Unit="bpm" CssClass="stat-num--small" Label="Hvilepuls" />
            </div>
        </section>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public OverviewStats Stats { get; set; } = default!;

    // The most recent WHOOP reading, when a WHOOP account is connected and has synced.
    [Parameter]
    public RecoveryDay? LatestRecovery { get; set; }

    private static string Hours(TimeSpan span)
    {
        var hours = span.TotalHours;
        return hours >= 10 ? hours.ToString("N0") : hours.ToString("N1");
    }

    private static string Rating(double? change) =>
        change is { } c ? c.ToString("+0.0;-0.0") : "–";

    private static string RatingClass(double? change) =>
        change is not { } c ? "" : c >= 0 ? "stat-num--up" : "stat-num--down";

    private static string BandClass(RecoveryBand band) => band switch
    {
        RecoveryBand.High => "stat-num--up",
        RecoveryBand.Medium => "stat-num--mid",
        _ => "stat-num--down"
    };
}
